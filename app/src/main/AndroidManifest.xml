<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 2.3 BLE observation adapter permissions (per docs/permission-capability-matrix.md).
         neverForLocation is deliberately NOT asserted: beacon observation coverage is
         prioritized, so BLE scan results can potentially reveal proximity/location; the app
         never derives, retains, or transmits geographic location. -->
    <!-- Runtime permission on Android 12+ (API 31+) for BLE scans. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <!-- Legacy install-time permissions for Android 10-11 devices (API 29-30). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Required on ALL supported buckets (29+) for BLE scan results because
         neverForLocation is not asserted (official docs: keep it unless deriving location
         is strongly disclaimed). NOT used to collect location: no location APIs are called. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 12+ (API 31+) runtime requests must include COARSE together with FINE:
         the user may grant approximate-only access (CoarseFineLocation lint gate). A
         COARSE-only grant does NOT satisfy BLE scan / Wi-Fi getScanResults() operations,
         which require FINE — the fail-closed probes keep refusing in that case. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- No BLUETOOTH_CONNECT / BLUETOOTH_ADVERTISE: the app never pairs, connects, or advertises. -->
    <!-- Phase 2.4 receive-only Wi-Fi observer: normal (install-time) permission to read
         system-cached scan results via getScanResults(). The app NEVER calls startScan().
         ACCESS_FINE_LOCATION (declared above) is required for getScanResults() on all
         supported Android versions; NEARBY_WIFI_DEVICES is deliberately NOT adopted.
         No CHANGE_WIFI_STATE, INTERNET, or Wi-Fi connection permissions. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      Phase 1 declares NO permissions: no scanning, no location, no networking.
      Permission/scanning design is documented for Phase 2+ but intentionally
      not implemented here.
    -->
    <application
        android:label="Radio Observer"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
